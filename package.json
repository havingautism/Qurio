{
  "name": "qurio",
  "private": true,
  "version": "0.0.1",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "rsbuild dev",
    "dev:py": "cross-env HOST=127.0.0.1 PORT=3002 FRONTEND_URLS=http://localhost:3000 uv run --project backend-python python backend-python/run.py",
    "dev:electron": "bunx electron electron/main.cjs",
    "build": "rsbuild build",
    "build:web": "rsbuild build",
    "build:backend:exe": "cd backend-python && uv run pyinstaller --noconfirm --clean --onefile --name QurioBackend run.py",
    "build:electron": "bun run build:web && bun run build:backend:exe && bunx electron-builder --win nsis",
    "start": "rsbuild preview",
    "start:electron": "bunx electron electron/main.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:py": "cd backend-python && uv run ruff check src",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:py": "cd backend-python && uv run ruff format src"
  },
  "build": {
    "appId": "com.qurio.desktop",
    "productName": "Qurio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-python/dist/QurioBackend.exe",
        "to": "backend/QurioBackend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@google/genai": "^1.41.0",
    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.2",
    "@langchain/core": "^1.1.24",
    "@langchain/google-genai": "^2.1.18",
    "@langchain/openai": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-router": "^1.160.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emoji-mart": "^5.6.0",
    "fluentui-emoji-js": "^1.2.1",
    "framer-motion": "^12.34.0",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.11.0",
    "openai": "^6.22.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "simplex-noise": "^4.0.3",
    "streamdown": "^2.2.0",
    "styled-components": "^6.3.9",
    "tailwind-merge": "^3.4.1",
    "three": "^0.182.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-node-polyfill": "^1.4.4",
    "@rsbuild/plugin-react": "^1.4.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "wait-on": "^8.0.3"
  }
}
